# Edge Function secrets. Locally: copy to supabase/functions/.env (git-ignored) for
# `supabase functions serve`. Remote: `supabase secrets set --env-file <file>`.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are provided automatically.

# livekit-token
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SERVER_URL=

# jobs-run: must match the Vault secret 'sunny_jobs_secret' (local value is in supabase/seed.sql)
SUNNY_JOBS_SECRET=
# Optional: how long one run may take before deferring (ms, default 120000)
# SUNNY_JOB_RUN_BUDGET_MS=120000

# Managed Agents (ids printed by supabase/scripts/setup_managed_agent.ts)
ANTHROPIC_API_KEY=
SUNNY_AGENT_ID=
SUNNY_ENVIRONMENT_ID=
# Optional: per-session spend cap in US cents (default 100)
# SUNNY_AGENT_SESSION_BUDGET_CENTS=100

# Google Calendar (OAuth web client; redirect URI must be registered in Google Cloud)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:54321/functions/v1/google-oauth/callback
GOOGLE_OAUTH_STATE_SECRET=

// Sunny backend the app talks to: the remote project by default. Override in the
// git-ignored .env.xcconfig, e.g. for the local Supabase stack in the simulator:
//   SUNNY_SUPABASE_URL = http:/$()/127.0.0.1:54321
//   SUNNY_SUPABASE_KEY = <PUBLISHABLE_KEY from `supabase status`>
// ("/$()/" keeps "//" from starting an xcconfig comment.)
SUNNY_SUPABASE_URL = https:/$()/rlihlcgyjqyzkpzijtsp.supabase.co
SUNNY_SUPABASE_KEY = sb_publishable_CS4m5blzfvgnm7xbjCEp1A_mP5CuRSM

PRODUCT_BUNDLE_IDENTIFIER=com.livekit.example.VoiceAssistant
DEVELOPMENT_TEAM = 76TVFCUKK7;

#include? ".env.xcconfig"

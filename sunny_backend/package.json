{
  "name": "sunny_backend",
  "version": "0.1.0",
  "private": true,
  "description": "Sunny's Convex backend: shared household state, scheduler, agent runtime and integrations.",
  "type": "module",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy",
    "typecheck": "tsc --noEmit -p convex && tsc --noEmit -p scripts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write convex scripts",
    "format:check": "prettier --check convex scripts",
    "setup:agent": "tsx --env-file=.env.local scripts/setup_managed_agent.ts",
    "caregiver": "tsx scripts/caregiver.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/workflow": "^0.4.10",
    "@convex-dev/workpool": "^0.4.15",
    "convex": "^1.48.0",
    "convex-helpers": "^0.1.129",
    "livekit-server-sdk": "^2.19.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.0.5",
    "convex-test": "^0.0.66",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
